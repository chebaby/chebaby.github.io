---
import { principles } from '../data/principles';
---

<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="approach-title">How I approach the work</h2>
      <p>Principles behind the technical decisions I make on any project.</p>
    </div>

    <ul class="grid">
      {
        principles.map((item, index) => (
          <li class="reveal" style={`--delay:${(index % 3) * 80}ms`}>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-top: 22px;
    border-top: 2px solid var(--ink);
  }

  h3 {
    margin-bottom: 10px;
    font-size: 1.3rem;
    line-height: 1.2;
  }

  p {
    color: var(--mute);
    font-size: 0.97rem;
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
