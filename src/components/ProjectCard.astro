---
import type { Project } from '../data/projects';
import ProjectArt from './ProjectArt.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
---

<article class="card reveal" style={`--delay:${(index % 3) * 80}ms`}>
  <div class="art-frame">
    <ProjectArt slug={project.slug} name={project.name} index={index} sizes="(min-width: 1100px) 400px, (min-width: 680px) 45vw, 100vw" />
  </div>

  <div class="body">
    <p class="category mono">{project.category}</p>
    <h3>{project.name}</h3>
    <p class="summary">{project.summary}</p>

    <div class="contribution">
      <h4 class="label mono">My contribution</h4>
      <p>{project.contribution}</p>
    </div>

    <ul class="chips" aria-label="Technologies">
      {project.technologies.map((tech) => <li>{tech}</li>)}
    </ul>

    {
      (project.note || project.link) && (
        <div class="context">
          {project.note && <p class="note">{project.note}</p>}
          {project.link && (
            <a class="link-arrow" href={project.link.href} target="_blank" rel="noopener noreferrer">
              {project.link.label}
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg);
  }

  .art-frame {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    border-radius: 5px 5px 0 0;
    background: var(--surf);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
  }

  .category {
    color: var(--acc);
    letter-spacing: 0.03em;
    text-transform: none;
    font-size: 0.8rem;
  }

  h3 {
    font-size: clamp(1.6rem, 2.4vw, 2rem);
    line-height: 1.1;
  }

  .summary {
    color: var(--mute);
    font-size: 0.97rem;
  }

  /* The contribution is the point of the card, so it gets its own accent rule and a label, not a heavier type size. */
  .contribution {
    padding-left: 14px;
    border-left: 2px solid var(--acc);
    font-size: 0.93rem;
  }

  .label {
    margin: 0 0 4px;
    color: var(--mute);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.03em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 3px 10px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font: 400 0.76rem var(--mono);
  }

  /* Pinned to the bottom so notes and links line up when cards in a row differ in height. */
  .context {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .note {
    color: var(--mute);
    font-size: 0.86rem;
  }

  .context .link-arrow {
    font-size: 0.93rem;
  }
</style>
