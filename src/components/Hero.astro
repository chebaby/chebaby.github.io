---
import { site } from '../config/site';
---

<div class="wrap hero" id="top">
  <div class="intro">
    <p class="role">Software engineer · Laravel, full-stack &amp; application security</p>
    <h1>I build web applications that are reliable, maintainable, and secure.</h1>
    <p class="lede">
      Backend engineering and full-stack development, with application security and a pragmatic approach to technology:
      software that teams can understand, run and extend.
    </p>

    <div class="cta">
      <a class="btn btn--primary" href="#contact" data-enquiry="project">Discuss a project</a>
      <a class="btn" href="#contact" data-enquiry="employment">Hiring or collaborating?</a>
      <a class="link-arrow" href="#work">Explore selected work ↓</a>
    </div>

    <p class="direct">
      <span>Direct:</span>
      <a href={`mailto:${site.email}`} class="mono-email" id="hero-email">{site.email}</a>
      <button type="button" class="copy" id="copy-email" data-email={site.email} hidden>Copy</button>
      <span class="sr-only" role="status" id="copy-status"></span>
    </p>
  </div>

  <figure class="fig">
    <svg class="disc" viewBox="0 0 400 400" fill="none" aria-hidden="true" focusable="false">
      <circle cx="200" cy="200" r="190" fill="var(--acc)"></circle>
      <circle class="pulse" cx="200" cy="200" r="132" stroke="var(--bg)" stroke-width="1.2" opacity="0.6"></circle>
      <circle class="counter" cx="200" cy="200" r="162" stroke="var(--bg)" stroke-width="0.8" stroke-dasharray="3 6" opacity="0.6"></circle>
      <g class="grid">
        <circle cx="200" cy="200" r="132" stroke="var(--bg)" stroke-width="1.2" opacity="0.85"></circle>
        <circle cx="200" cy="200" r="74" stroke="var(--bg)" stroke-width="1.2" opacity="0.85"></circle>
        <path d="M10 200H390M200 10V390" stroke="var(--bg)" stroke-width="1.2" opacity="0.85"></path>
        <circle cx="200" cy="68" r="2.5" fill="var(--bg)"></circle>
        <circle cx="200" cy="332" r="2.5" fill="var(--bg)"></circle>
        <circle cx="68" cy="200" r="2.5" fill="var(--bg)"></circle>
        <circle cx="332" cy="200" r="2.5" fill="var(--bg)"></circle>
      </g>
      <g class="sweep">
        <line x1="200" y1="200" x2="388" y2="200" stroke="var(--bg)" stroke-width="1.4" stroke-opacity="0.75"></line>
        <circle class="blip" cx="328" cy="200" r="3" fill="var(--bg)"></circle>
      </g>
      <circle cx="200" cy="200" r="4.5" fill="var(--bg)"></circle>
      <rect class="block" x="248" y="248" width="142" height="142" fill="var(--ink)"></rect>
      <g fill="var(--bg)" font-size="11" font-family="var(--mono)" letter-spacing="0.08em" opacity="0.8">
        <text x="262" y="278">FIG. 01</text>
        <text x="262" y="296">SURFACE · MAPPED</text>
      </g>
    </svg>
    <figcaption>Fig. 1. The part users don’t see is the part that has to work.</figcaption>
  </figure>
</div>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 40px 24px;
    align-items: center;
    padding-block: clamp(28px, 5vw, 72px) clamp(48px, 6vw, 96px);
  }

  .intro {
    grid-column: 1 / 9;
  }

  .fig {
    grid-column: 9 / 13;
    grid-row: 1;
    margin: 0;
  }

  .role {
    max-width: 34rem;
    margin-bottom: clamp(14px, 2vw, 26px);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    color: var(--mute);
    font-weight: 500;
  }

  h1 {
    max-width: 17ch;
    margin-bottom: 1.75rem;
    font-size: clamp(2.4rem, 5.6vw, 4.5rem);
    line-height: 1.04;
  }

  .lede {
    max-width: 38rem;
    margin-bottom: 2rem;
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.6;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }

  .cta .btn {
    min-height: 54px;
    padding: 0 28px;
  }

  .cta .link-arrow {
    padding: 12px 8px;
  }

  .direct {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 24px;
    color: var(--mute);
    font-size: 0.92rem;
  }

  .mono-email {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.88rem;
    overflow-wrap: anywhere;
  }

  .copy {
    padding: 6px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surf);
    color: var(--ink);
    font: 500 0.78rem var(--sans);
    cursor: pointer;
  }

  .copy:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .fig svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  figcaption {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    color: var(--mute);
    font-size: 0.85rem;
  }

  /* Tablet and mobile: the figure joins the flow after the text, so it can never overlap it. */
  @media (max-width: 980px) {
    .intro,
    .fig {
      grid-column: 1 / -1;
    }

    .fig {
      grid-row: auto;
      width: min(100%, 280px);
    }
  }

  /* ----- Radar motion (decorative) ----- */
  @media (prefers-reduced-motion: no-preference) {
    .disc {
      transform-origin: 50% 50%;
      animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .grid {
      transform-origin: 200px 200px;
      animation: spin 48s linear infinite;
    }

    .counter {
      transform-origin: 200px 200px;
      animation: spin 64s linear infinite reverse;
    }

    .sweep {
      transform-origin: 200px 200px;
      animation: spin 9s linear infinite;
    }

    .pulse {
      transform-origin: 200px 200px;
      animation: pulse 4.5s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    }

    .blip {
      transform-origin: 328px 200px;
      animation: blip 2.2s ease-in-out infinite;
    }

    .block {
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .fig:hover .grid {
      animation-duration: 20s;
    }

    .fig:hover .sweep {
      animation-duration: 4.5s;
    }

    .fig:hover .block {
      transform: translate(-6px, -6px);
    }
  }

  @keyframes rise {
    from {
      transform: scale(0.82);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    70%,
    100% {
      transform: scale(1.4);
      opacity: 0;
    }
  }

  @keyframes blip {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }
</style>

<script>
  // The copy button only exists where the Clipboard API does; the email is always a plain mailto link as well.
  const button = document.querySelector<HTMLButtonElement>('#copy-email');
  const status = document.querySelector<HTMLElement>('#copy-status');

  if (button && status && navigator.clipboard?.writeText) {
    button.hidden = false;
    let timer: number | undefined;

    button.addEventListener('click', async () => {
      let message: string;
      try {
        await navigator.clipboard.writeText(button.dataset.email ?? '');
        message = 'Copied';
      } catch {
        message = 'Copy failed. Select the address instead';
      }
      status.textContent = message;
      button.textContent = message === 'Copied' ? 'Copied' : 'Copy failed';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = 'Copy';
        status.textContent = '';
      }, 2500);
    });
  }
</script>
