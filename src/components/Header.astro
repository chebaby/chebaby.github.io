---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: '#services', label: 'Capabilities' },
  { href: '#work', label: 'Selected work' },
  { href: '#approach', label: 'Approach' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header" id="site-header">
  <div class="wrap bar">
    <a class="brand" href="#top" aria-label="Nour-Eddine Ech-Chebaby, back to top">
      Nour-Eddine <span>Ech-Chebaby</span>
    </a>

    <nav class="nav" id="site-nav" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a class="btn btn--primary btn--small" href="#contact" data-enquiry="project">Discuss a project</a>
        </li>
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <a class="btn btn--primary btn--small header-cta" href="#contact" data-enquiry="project">Discuss a project</a>
      <button type="button" class="menu-button" id="menu-button" aria-expanded="false" aria-controls="site-nav">
        <span class="menu-label">Menu</span>
      </button>
    </div>
  </div>
  <div class="progress" id="scroll-progress" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    min-height: var(--header-h);
  }

  .brand {
    font: 700 1.2rem/1 var(--serif);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand span {
    color: var(--acc);
  }

  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(18px, 2.6vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a:not(.btn) {
    display: inline-block;
    padding: 10px 0;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    background: linear-gradient(var(--acc), var(--acc)) 0 100% / 0 2px no-repeat;
    transition: background-size 0.25s;
  }

  .nav a:not(.btn):hover,
  .nav a[aria-current] {
    background-size: 100% 2px;
  }

  .nav a[aria-current] {
    color: var(--acc);
    font-weight: 600;
  }

  .nav-cta {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-button {
    display: none;
    align-items: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 0.9rem var(--sans);
    cursor: pointer;
  }

  .menu-button[aria-expanded='true'] {
    background: var(--ink);
    color: var(--bg);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--acc);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* Narrow screens: without JavaScript the links simply wrap under the brand. */
  @media (max-width: 880px) {
    .header-cta {
      display: none;
    }

    .nav {
      order: 3;
      width: 100%;
    }

    .nav ul {
      gap: 0 20px;
    }

    :global(.js) .menu-button {
      display: inline-flex;
    }

    /* With JavaScript the links collapse into a menu. */
    :global(.js) .nav {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: none;
      width: auto;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    :global(.js) .site-header[data-menu-open] .nav {
      display: block;
    }

    :global(.js) .nav ul {
      flex-direction: column;
      gap: 0;
      padding: 8px var(--pad) 20px;
    }

    :global(.js) .nav a:not(.btn) {
      display: block;
      padding: 14px 0;
      font-size: 1.1rem;
      border-bottom: 1px solid var(--rule);
      background: none;
    }

    :global(.js) .nav-cta {
      display: block;
      padding-top: 16px;
    }

    :global(.js) .nav-cta .btn {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('#site-header')!;
  const menuButton = document.querySelector<HTMLButtonElement>('#menu-button')!;
  const nav = document.querySelector<HTMLElement>('#site-nav')!;
  const progress = document.querySelector<HTMLElement>('#scroll-progress')!;
  const menuLabel = menuButton.querySelector('.menu-label')!;

  /* ----- Mobile menu ----- */
  const setMenu = (open: boolean) => {
    header.toggleAttribute('data-menu-open', open);
    menuButton.setAttribute('aria-expanded', String(open));
    menuLabel.textContent = open ? 'Close' : 'Menu';
  };
  const isOpen = () => header.hasAttribute('data-menu-open');

  menuButton.addEventListener('click', () => setMenu(!isOpen()));
  nav.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('click', (event) => {
    if (isOpen() && !header.contains(event.target as Node)) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setMenu(false);
      menuButton.focus();
    }
  });
  window.matchMedia('(min-width: 881px)').addEventListener('change', (event) => {
    if (event.matches) setMenu(false);
  });

  /* ----- Scroll progress ----- */
  let ticking = false;
  const updateProgress = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
    progress.style.transform = `scaleX(${ratio})`;
    ticking = false;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  window.addEventListener('resize', updateProgress);
  updateProgress();

  /* ----- Scroll-spy: mark the nav link of the section crossing a band near the top of the viewport ----- */
  const links = new Map<string, HTMLAnchorElement>();
  nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]:not(.btn)').forEach((a) => links.set(a.hash.slice(1), a));

  let current: string | null = null;
  const setCurrent = (id: string | null) => {
    if (id === current) return;
    if (current) links.get(current)?.removeAttribute('aria-current');
    if (id) links.get(id)?.setAttribute('aria-current', 'location');
    current = id;
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) setCurrent(entry.target.id);
        else if (entry.target.id === current) setCurrent(null);
      }
    },
    { rootMargin: '-30% 0px -65% 0px' },
  );
  links.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) spy.observe(section);
  });
</script>
