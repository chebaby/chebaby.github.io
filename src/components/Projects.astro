---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head reveal">
      <h2 id="work-title">Selected work</h2>
      <p>
        Five projects, described with what I can stand behind. Each card says which part was mine, and artwork is
        illustrative rather than a screenshot.
      </p>
    </div>

    <div class="grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}

      <aside class="next reveal" style="--delay:160ms" aria-labelledby="next-title">
        <h3 id="next-title">Have something similar in mind?</h3>
        <p>Whether it is a project, a role or a possible collaboration, I would like to hear about it.</p>
        <div class="next-actions">
          <a class="btn btn--primary btn--small" href="#contact" data-enquiry="project">Discuss a project</a>
          <a class="btn btn--small" href="#contact" data-enquiry="employment">Employment</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  /* Fills the sixth cell so five equal cards sit in a clean 3 + 3 grid. It is deliberately not card-shaped. */
  .next {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 24px;
    border: 1.5px dashed var(--ink);
    border-radius: 6px;
  }

  .next h3 {
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1.12;
  }

  .next p {
    color: var(--mute);
  }

  .next-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-dialog-open]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelector<HTMLDialogElement>(`#${button.dataset.dialogOpen}`)?.showModal();
    });
  });

  // Escape, focus trapping and returning focus to the opening button are handled natively by <dialog>.
  document.querySelectorAll<HTMLDialogElement>('dialog.project-dialog').forEach((dialog) => {
    // The dialog has no padding, so a click whose target is the dialog itself landed on the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelectorAll('[data-dialog-close]').forEach((el) => el.addEventListener('click', () => dialog.close()));
  });
</script>
