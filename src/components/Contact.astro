---
import { enquiryTypes, site } from '../config/site';

const hasEndpoint = site.formEndpoint !== '';
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap layout">
    <div class="intro reveal">
      <h2 id="contact-title">Let’s talk about the work.</h2>
      <p>
        A few lines is enough to start. Tell me about the project, the role or the idea, and I will reply by email.
      </p>

      <div class="paths">
        <div>
          <h3>Project enquiries</h3>
          <p>New applications, improvements to existing ones, or an application security review.</p>
        </div>
        <div>
          <h3>Employment &amp; collaboration</h3>
          <p>Open to hearing about engineering roles and to working with teams and other developers.</p>
        </div>
      </div>

      <p class="mute direct">
        Prefer email? <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>

    <form
      class="form reveal"
      id="contact-form"
      novalidate
      aria-label="Contact form"
      data-endpoint={site.formEndpoint}
      data-email={site.email}
      action={hasEndpoint ? site.formEndpoint : `mailto:${site.email}`}
      method="post"
      enctype={hasEndpoint ? 'multipart/form-data' : 'text/plain'}
    >
      <div class="row">
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" autocomplete="name" required aria-describedby="f-name-error" />
          <p class="error" id="f-name-error" hidden></p>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="f-email-error" />
          <p class="error" id="f-email-error" hidden></p>
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="f-org">Organisation <span class="opt">(optional)</span></label>
          <input id="f-org" name="organisation" autocomplete="organization" />
        </div>
        <div class="field">
          <label for="f-type">Type of enquiry</label>
          <select id="f-type" name="enquiry" required aria-describedby="f-type-error">
            <option value="">Choose one</option>
            {enquiryTypes.map((type) => <option value={type.value}>{type.label}</option>)}
          </select>
          <p class="error" id="f-type-error" hidden></p>
        </div>
      </div>

      <div class="field">
        <label for="f-message">Short description</label>
        <textarea
          id="f-message"
          name="message"
          rows="6"
          required
          aria-describedby="f-message-error"
          placeholder="What do you want to build, fix or discuss? Mention constraints or existing technologies if relevant."></textarea>
        <p class="error" id="f-message-error" hidden></p>
      </div>

      <div class="field">
        <label for="f-timeline">Timeline or budget <span class="opt">(optional)</span></label>
        <input id="f-timeline" name="timeline_or_budget" placeholder="e.g. start in January, fixed scope" />
      </div>

      {
        hasEndpoint && (
          <div class="trap" aria-hidden="true">
            <label>
              Leave this empty
              <input name="_gotcha" tabindex="-1" autocomplete="off" />
            </label>
          </div>
        )
      }

      <div class="actions">
        <button class="btn btn--primary" type="submit" id="submit-button">
          {hasEndpoint ? 'Send message' : 'Write the email'}
        </button>
        {!hasEndpoint && <button class="btn" type="button" id="copy-message" hidden>Copy message</button>}
      </div>

      {
        !hasEndpoint && (
          <p class="mute hint">
            This form does not send anything by itself. It opens your email app with your message filled in, and nothing
            is delivered until you send it from there.
          </p>
        )
      }

      <div class="status" id="form-status" role="status" aria-live="polite" tabindex="-1" hidden></div>
    </form>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 40px 24px;
  }

  .intro {
    grid-column: 1 / 6;
  }

  .form {
    grid-column: 7 / 13;
  }

  @media (max-width: 900px) {
    .intro,
    .form {
      grid-column: 1 / -1;
    }
  }

  h2 {
    margin-bottom: 22px;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    line-height: 1.06;
  }

  .paths {
    display: grid;
    gap: 20px;
    margin-top: 32px;
  }

  .paths > div {
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  .paths h3 {
    margin-bottom: 6px;
    font-size: 1.25rem;
  }

  .paths p {
    color: var(--mute);
    font-size: 0.95rem;
  }

  .direct {
    margin-top: 28px;
  }

  .direct a {
    color: var(--ink);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* ----- Form ----- */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  .field {
    margin-bottom: 20px;
  }

  label {
    display: block;
    margin-bottom: 6px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .opt {
    color: var(--mute);
    font-weight: 400;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 12px 14px;
    border: 0;
    border-bottom: 1.5px solid var(--ink);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    appearance: none;
  }

  textarea {
    min-height: 150px;
    border: 1.5px solid var(--ink);
    resize: vertical;
  }

  select {
    padding-right: 40px;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position:
      calc(100% - 20px) 50%,
      calc(100% - 14px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
  }

  select option {
    background: var(--bg);
    color: var(--ink);
  }

  ::placeholder {
    color: var(--mute);
    opacity: 1;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--acc);
    outline-offset: 2px;
  }

  [aria-invalid='true'] {
    border-color: var(--acc);
    background-color: color-mix(in srgb, var(--acc) 8%, transparent);
  }

  .error {
    margin-top: 6px;
    color: var(--acc);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .error[hidden],
  .status[hidden],
  .actions [hidden] {
    display: none;
  }

  /* Honeypot: invisible to people and assistive technology, tempting to bots. */
  .trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hint {
    margin-top: 16px;
    font-size: 0.9rem;
  }

  .status {
    margin-top: 18px;
    padding: 16px 18px;
    border-left: 3px solid var(--ink);
    background: var(--surf);
    font-size: 0.95rem;
  }

  .status--error {
    border-left-color: var(--acc);
  }

  .status a {
    font-weight: 600;
  }
</style>

<script>
  import { enquiryTypes } from '../config/site';

  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const status = form.querySelector<HTMLElement>('#form-status')!;
  const submitButton = form.querySelector<HTMLButtonElement>('#submit-button')!;
  const copyButton = form.querySelector<HTMLButtonElement>('#copy-message');
  const endpoint = form.dataset.endpoint ?? '';
  const email = form.dataset.email ?? '';

  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  /* ----- Validation ----- */
  const rules: Record<string, (value: string) => string | null> = {
    name: (v) => (v.trim().length < 2 ? 'Enter your name so I know who to reply to.' : null),
    email: (v) =>
      /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()) ? null : 'Enter a valid email address, for example name@company.com.',
    enquiry: (v) => (v ? null : 'Choose the type of enquiry, or “Something else”.'),
    message: (v) =>
      v.trim().length < 20 ? 'Describe it in at least 20 characters so I can understand the context.' : null,
  };

  const validate = (name: string): HTMLElement | null => {
    const input = field(name);
    const error = form.querySelector<HTMLElement>(`#${input.id}-error`)!;
    const message = rules[name](input.value);
    input.setAttribute('aria-invalid', String(Boolean(message)));
    error.textContent = message ?? '';
    error.hidden = !message;
    return message ? input : null;
  };

  Object.keys(rules).forEach((name) => {
    const input = field(name);
    input.addEventListener('blur', () => validate(name));
    // Once a field has been flagged, re-check while typing so the message disappears as soon as it is fixed.
    input.addEventListener('input', () => input.getAttribute('aria-invalid') === 'true' && validate(name));
  });

  /* ----- Status messages ----- */
  const show = (html: string | Node, kind: 'info' | 'error' = 'info') => {
    status.className = kind === 'error' ? 'status status--error' : 'status';
    status.replaceChildren(html instanceof Node ? html : document.createTextNode(html));
    status.hidden = false;
  };

  const mailtoLink = (label: string) => {
    const a = document.createElement('a');
    a.href = buildMailto();
    a.textContent = label;
    return a;
  };

  const message = (...parts: (string | Node)[]) => {
    const p = document.createElement('p');
    p.append(...parts);
    return p;
  };

  /* ----- Mailto fallback (used when no form endpoint is configured) ----- */
  const typeLabel = (value: string) => enquiryTypes.find((t) => t.value === value)?.label ?? 'Not specified';

  const buildBody = () => {
    const data = new FormData(form);
    const get = (key: string) => String(data.get(key) ?? '').trim();
    return [
      `Name: ${get('name')}`,
      `Email: ${get('email')}`,
      `Organisation: ${get('organisation') || '-'}`,
      `Enquiry: ${typeLabel(get('enquiry'))}`,
      `Timeline or budget: ${get('timeline_or_budget') || '-'}`,
      '',
      get('message'),
    ].join('\n');
  };

  function buildMailto() {
    const name = String(new FormData(form).get('name') ?? '').trim();
    const subject = `${typeLabel(field('enquiry').value)}${name ? ` from ${name}` : ''}`;
    return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(buildBody())}`;
  }

  /* ----- Submit ----- */
  const validateAll = () => Object.keys(rules).map(validate).filter((el): el is HTMLElement => el !== null);

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    const invalid = validateAll();
    if (invalid.length) {
      show(`Please fix ${invalid.length} ${invalid.length === 1 ? 'field' : 'fields'} below before continuing.`, 'error');
      invalid[0].focus();
      return;
    }

    if (!endpoint) {
      // No backend: hand the message to the visitor's email app and say exactly that. Nothing is claimed as sent.
      window.location.href = buildMailto();
      show(
        message(
          'Your email app should now open with the message ready. Nothing has been sent until you send it there. If nothing opened, ',
          mailtoLink('use this link'),
          ` or write to ${email}.`,
        ),
      );
      return;
    }

    // Honeypot: a bot filled the hidden field. Drop the message without any success claim.
    if (String(new FormData(form).get('_gotcha') ?? '') !== '') return;

    submitButton.disabled = true;
    show('Sending…');
    try {
      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.reset();
      show('Thank you. Your message has been sent and I will reply by email.');
    } catch {
      show(
        message('The message could not be sent, so please do not assume I received it. You can ', mailtoLink('email me directly'), ` at ${email}.`),
        'error',
      );
    } finally {
      submitButton.disabled = false;
    }
  });

  /* ----- Copy message (fallback mode only) ----- */
  if (copyButton && navigator.clipboard?.writeText) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      const invalid = validateAll();
      if (invalid.length) {
        show('Complete the required fields first, then copy the message.', 'error');
        invalid[0].focus();
        return;
      }
      try {
        await navigator.clipboard.writeText(`To: ${email}\n\n${buildBody()}`);
        show(`Message copied. Paste it into an email to ${email}.`);
      } catch {
        show('Copying was blocked by the browser. Select the text in the form instead.', 'error');
      }
    });
  }

  /* ----- Entry points elsewhere on the page can preselect the enquiry type ----- */
  document.querySelectorAll<HTMLElement>('[data-enquiry]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = field('enquiry') as HTMLSelectElement;
      select.value = link.dataset.enquiry ?? '';
      if (select.value) validate('enquiry');
    });
  });
</script>
